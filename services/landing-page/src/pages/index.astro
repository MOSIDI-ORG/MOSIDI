---
// Astro Imports
import { Image } from "astro:assets";

// Layout Import
import Default from "../layouts/Default.astro";

// Module Imports
import CopyHighlight from "../modules/CopyHighlight/CopyHighlight.astro";
import Footer from "../modules/Footer/Footer.astro";
import HeadlineHighlight from "../modules/HeadlineHighlight.astro";
import InlineDecoration from "../modules/InlineDecoration.astro";
import Navigation from "../modules/Navigation/Navigation.astro";
import Stage from "../modules/Stage.astro";
import TextGrid from "../modules/TextGrid/TextGrid.astro";
import NavigationItemWrapper from "../modules/Navigation/NavigationItemWrapper.astro";
import CopyHighlightItemWrapper from "../modules/CopyHighlight/CopyHighlightItemWrapper.astro";
import TextGridItem from "../modules/TextGrid/TextGridItem.astro";
import FooterFundingContainer from "../modules/Footer/FooterFundingContainer.astro";
import FooterFundingLogoContainer from "../modules/Footer/FooterFundingLogoContainer.astro";
import FooterNavigationRow from "../modules/Footer/FooterNavigationRow.astro";
import Media from "../modules/Media.astro";
// import FooterLink from "../modules/Footer/FooterLink.astro";

// Component Imports
import NavItem from "../components/NavItem.astro";
import Button from "../components/Button.astro";
import TextBadge from "../components/TextBadge.astro";

// Image/Media Imports
import innovativeHochschule from "../assets/Innovative Hochschule BMFTR GWK RGB png C1.png";
import fhp from "../assets/logo-fhpotsdam-innowest-c-fhpostdam-2016-11-16.svg";
import innowest from "../assets/innowest.svg";
import thb from "../assets/logo-thbrandenburg-innowest-c-thb-2015-10-05.svg";
import hnee from "../assets/logo-hne-eberswalde-innowest-c-hne-eberswalde.svg";
import stageImage from "../assets/stage.jpg";
import teaser1 from "../assets/teaser-sources.jpg";
import teaser2 from "../assets/teaser-federal.jpg";
import teaser3 from "../assets/teaser-open.jpg";
import teaser4 from "../assets/teaser-network.jpg";
import trailerImage from "../assets/MOSIDI-Teaser-Thumbnail.jpg";
import trailerSubs from "../assets/MOSIDI-Trailer.vtt";
import teaserBStPub from "../assets/BStPub3.png";
import teaserSCCON from "../assets/SCCON25.jpeg";
import heroVideo from "../assets/hero_video_medium_wide.mp4";
import teaserGitHub from "../assets/github-mark-white.svg";
---

<Default title="MOSIDI" description="Landing Page">
	<Navigation colour="black">
		<NavigationItemWrapper colour="black" slot="navigationItemWrapper">
			<NavItem href="#" colour="white">MOSIDI</NavItem>
		</NavigationItemWrapper>
		<Button
			variant="filled"
			size={800}
			colour="white"
			href="https://tv4-geo-dev.innowest-brandenburg.de/app/"
			slot="navigationCTA">Prototypen testen</Button
		>
	</Navigation>
	<Stage colour="coloured" class="pb-4 md:pb-12">
		<!-- Fragments are "empty" tags in Astro.
		 This way, only the content is put
		 in the <h3> of the header, without
		 additional DOM Elements  -->
		<Fragment slot="header">Setze alles auf eine Karte.</Fragment>
		<Fragment slot="copy"
			>Mit MOSIDI einfach Daten von verschiedenen Portalen zusammenführen, mit eigenen Daten verschneiden, auswerten, visualisieren und bereitstellen. Die modulare Open Source-Lösung für eine nachhaltige datenbasierte Kommunalentwicklung.</Fragment
		>
		<div slot="media" class="relative w-full aspect-[16/9] md:aspect-[21/9] overflow-hidden rounded-2xl">
  <video
    class="absolute inset-0 w-full h-full 
         object-cover sm:object-center
         scale-[1.2] sm:scale-[1.15] md:scale-115 
         transition-transform duration-500 ease-out"
    autoplay
    muted
    playsinline
    loop
    poster={stageImage.src}
  >
    
    <source src={heroVideo} />
    Dein Browser unterstützt das Video-Tag nicht.
  </video>
</div>
	</Stage>
	<HeadlineHighlight colour="coloured" orientation="textLeft">
		<Fragment slot="headline">
			Open Source. Modular. Gemacht für Kommunen.
		</Fragment>
	</HeadlineHighlight>
	<Media fullWidth={true} class="bg-set-1-500">
		<div class="relative w-full aspect-[1920/1080] md:aspect-[1920/1080] overflow-hidden">
			<video
				class="absolute inset-0 w-full h-full 
					object-cover sm:object-center
					scale-[0.9] sm:scale-[0.9] md:scale-[0.9]"
				playsinline
				controls
				poster={trailerImage.src}
			>
				<track
					default
					kind="captions"
					srclang="de"
					label="Deutsch"
					src={trailerSubs} />
				<source src="https://fhpcloud.fh-potsdam.de/s/ip3kqCpNHpM9Pa4/download/MOSIDI-Trailer-720-medium.mp4" type="video/mp4" media="all and (max-width: 720px)" /> 
				<source src="https://fhpcloud.fh-potsdam.de/s/BJgzqizM8RZ5Mkr/download/MOSIDI-Trailer-1080-medium.mp4" type="video/mp4" /> 
				Dein Browser unterstützt das Video-Tag nicht.
			</video>
		</div>
	</Media>
<TextGrid colour="coloured">
	  <h2 class="col-span-full text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight mb-2">
    Aktuelles
  </h2>

  <TextGridItem>
  <div
    slot="media"
    class="block overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02] aspect-[4/3] w-full"
  >
    <a
      href="https://www.smartcountry.berlin/de/programm/programmueberblick#eventdate--Hitze,-Hochwasser,-Handlungsdruck-–-Wie-offene-Daten-zur-Resilienz-von-Kommunen-und-Regionen-beitragen--e8c1307f-a30b-4640-86ee-ff897ab8adb3"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image
        src={teaserSCCON}
        alt="Vorschau Smart Country Convention"
        class="w-full aspect-[4/3] sm:aspect-[16/9] object-cover"
      />
    </a>
  </div>
  <Fragment slot="headline">
  Smart Country Convention Berlin 2025
  </Fragment>
  <Fragment slot="copy">
    01. Oktober 2025: Mit einem Input und bei der anschließenden Diskussion waren wir mit MOSIDI in der bitkom Masterclass „Hitze, Hochwasser, Handlungsdruck – Wie offene Daten zur Resilienz von Kommunen und Regionen beitragen“ vertreten. Veranstaltet von den Arbeitskreisen „Smart City/Smart Region“ & „Open Data / Open API“.
  <a
    href="https://www.smartcountry.berlin/de/programm/programmueberblick#eventdate--Hitze,-Hochwasser,-Handlungsdruck-–-Wie-offene-Daten-zur-Resilienz-von-Kommunen-und-Regionen-beitragen--e8c1307f-a30b-4640-86ee-ff897ab8adb3"
    class="mt-3 block  px-3 py-2 text-left text-sm font-medium underline hover:no-underline focus:outline-none focus:ring-2 focus:ring-offset-2"
  >Zur Veranstaltung</a>
  </Fragment>
</TextGridItem>
  	<TextGridItem>
		
  <div
    slot="media"
    class="block overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02] aspect-[4/3] w-full"
  >
    <a
      href="https://www.bertelsmann-stiftung.de/de/publikationen/publikation/did/datennutzung-fuer-nachhaltige-kommunalentwicklung"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image
        src={teaserBStPub}
        alt="Vorschau Publikation Bertelsmann Stiftung"
        class="w-full h-auto object-cover"
      />
    </a>
  </div>
  			<Fragment slot="headline">Publikation</Fragment>
			<Fragment slot="copy">
				          Im Analysen und Konzepte-Heft 2/2024 der Bertelsmann Stiftung stellen wir neben dem konzeptionellen Ansatz von MOSIDI mehrere Partner und ihre Datenherausforderungen im Rahmen der nachhaltigen Kommunalentwicklung vor.
			
			<a
    href="https://www.bertelsmann-stiftung.de/de/publikationen/publikation/did/datennutzung-fuer-nachhaltige-kommunalentwicklung"
    class="mt-3 block  px-3 py-2 text-left text-sm font-medium underline hover:no-underline focus:outline-none focus:ring-2 focus:ring-offset-2"
  >Zur Publikation </a>
			</Fragment>
		</TextGridItem>
		
	</TextGrid>

	<TextGrid colour="coloured">
		
	 <h2 class="col-span-full text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight mb-2">
    Über MOSIDI
  </h2>	
		<TextGridItem>
			<Image src={teaser1} alt="Logos von Datenbereitsteller:innen" slot="media" />
			<Fragment slot="headline">Daten zusammenführen</Fragment>
			<Fragment slot="copy">
				MOSIDI führt Daten unterschiedlichster Bereitsteller:innen zusammen. Von kommunalen Bevölkerungsdaten bis hin zu aktuellen Wetter- und Klimadaten.
			</Fragment>
		</TextGridItem>
		<TextGridItem>
			<Image src={teaser2} alt="Verschiedene föderale Datenebenen" slot="media" />
			<Fragment slot="headline">Daten verschneiden</Fragment>
			<Fragment slot="copy">
				Die Daten können nicht nur visualisiert sondern auch einfach miteinander verschnitten werden, um neue Analysen und Erktennise zu ermöglichen.
			</Fragment>
		</TextGridItem>
		<TextGridItem>
			<Image src={teaser3} alt="Logos von Open Source Werkzeugen" slot="media" />
			<Fragment slot="headline">Offen &amp; Nachhaltig</Fragment>
			<Fragment slot="copy">
				MOSIDI ist Open Source und nutzt Open Source Technologien. Hierdurch sind wir offen für Partner:innen mit Blick auf Wartung und Weiterentwicklung.
			</Fragment>
		</TextGridItem>
		<TextGridItem>
			<Image src={teaser4} alt="Bild eines Netzwerks" slot="media" />
			<Fragment slot="headline">Von Kommunen für Kommunen</Fragment>
			<Fragment slot="copy">
				Die Anwendung wird aktuell gemeinsam mit Kommunen entlang realer kommunaler Bedarfe und Herausforderungen entwickelt.
			</Fragment>
		</TextGridItem>
	</TextGrid>
<TextGrid colour="coloured">
	  <h2 class="col-span-full text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight mb-2">
    Code
  </h2>

  <TextGridItem>
  <div
    slot="media"
    class="block overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02] aspect-[4/3] w-[50%] flex items-center justify-center"
  >
    <a
      href="https://github.com/MOSIDI-ORG/MOSIDI"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Image
        src={teaserGitHub}
        alt="Vorschau GitHub"
  		class="block overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 w-full scale-[1.3]"
      />
    </a>
  </div>
  <Fragment slot="headline">
  Open Source Code
  </Fragment>
  <Fragment slot="copy">
Der Code von MOSIDI ist im GitHub Repository zugänglich.
  <a
    href="https://github.com/MOSIDI-ORG/MOSIDI"
    class="mt-3 block  px-3 py-2 text-left text-sm font-medium underline hover:no-underline focus:outline-none focus:ring-2 focus:ring-offset-2"
  >Zum GitHub Repository</a>
  </Fragment>
</TextGridItem>
  	
		
	</TextGrid>

	<CopyHighlight>
		<Fragment slot="copy">
			MOSIDI wird vom Verbundvorhaben InNoWest mit Brandenburger Kommunen entwickelt. Interesse dabei zu sein? Kontaktieren Sie uns!
		</Fragment>
		<CopyHighlightItemWrapper slot="itemWrapper">
			<a href="https://www.innowest-brandenburg.de"><TextBadge form="badge">Mehr zum Verbundvorhaben erfahren &raquo;</TextBadge></a>
			<a href="mailto:leonard.higi@fh-potsdam.de"><TextBadge form="badge">Jetzt Kontakt aufnehmen &raquo;</TextBadge></a>
		</CopyHighlightItemWrapper>
	</CopyHighlight>
	<InlineDecoration colour="coloured" />
	<Footer>
		<FooterFundingContainer slot="funding">
			<FooterFundingLogoContainer slot="fundingLogos">
				<img
  src={innovativeHochschule.src}
  alt="Innovative Hochschule"
  class="h-[80px] md:h-[100px] w-auto transform 
         md:scale-[2] md:translate-x-[-90%]
         transition-transform duration-300"
  style="
    max-height:none !important;
    flex-shrink:0;
    transform-origin:left center;
  "
/>
				<Image
					src={fhp}
					alt="Fachhochschule Potsdam"
					height="39"
				/>
				<Image
					src={thb}
					alt="Technische Hochschule Brandenburg"
					height="39"
				/>
				<Image
					src={hnee}
					alt="Hochschule für nachhaltige Entwicklung Eberswalde"
					height="39"
				/>
				<Image
					src={innowest}
					alt="InNoWest"
					height="39"
				/>
			</FooterFundingLogoContainer>
		</FooterFundingContainer>
		<FooterNavigationRow slot="navigationRow">
			<!-- <FooterLink href="#">Nav Item 1</FooterLink>
			<FooterLink href="#">Nav Item 2</FooterLink>
			<FooterLink href="#">Nav Item 3</FooterLink> -->
		</FooterNavigationRow>
	</Footer>
</Default>
