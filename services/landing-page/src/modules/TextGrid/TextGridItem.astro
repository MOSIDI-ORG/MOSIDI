---
import Media from "../Media.astro";
---

<div class="col-span-2 flex flex-col gap-6 md:col-span-4 lg:col-span-3">
	<Media fullWidth>
		<slot name="media" />
	</Media>
	<h4 class="headline-h6">
		<slot name="headline" />
	</h4>
	<div class="copy-500 text-left m-0
              [&_p]:m-0
              [&_a]:block [&_a]:mt-3 [&_a]:ml-0 [&_a]:pl-0
             [&_a]:underline [&_a:hover]:no-underline">
    <slot name="copy" />
  </div>
</div>
