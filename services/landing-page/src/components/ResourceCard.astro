---
const { title, text, href, thumbnail } = Astro.props;
---

<article class="card">
  <a href={href} target="_blank" rel="noopener noreferrer">
    <img src={thumbnail} alt={title} loading="lazy" class="thumb" />
  </a>
  <div class="body">
    <h3 class="title">
      <a href={href} target="_blank" rel="noopener noreferrer">{title}</a>
    </h3>
    <p class="text">{text}</p>
  </div>

  <style>
    .card { 
      border: 1px solid #e5e7eb; 
      border-radius: .75rem; 
      padding: 1rem; 
      max-width: 400px; 
    }
    .thumb { 
      width: 100%; 
      height: auto; 
      border-radius: .5rem; 
      margin-bottom: .75rem; 
      object-fit: cover; 
    }
    .title { margin: 0 0 .25rem; font-size: 1.2rem; }
    .title a { text-decoration: none; color: inherit; }
    .text { margin: 0; color: #374151; }
  </style>
</article>
